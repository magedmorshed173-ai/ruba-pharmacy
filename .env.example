# ── قاعدة البيانات — Neon Postgres (v4.2، الموصى به) ──
# DATABASE_URL: الاتصال المجمّع (pooled) للتشغيل — DIRECT_URL: المباشر للترحيلات
# أنشئ مشروعك في console.neon.tech وانسخ السلسلتين من لوحة المشروع.
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require"

# ── بديل التطوير المحلي (SQLite) ──
# DATABASE_URL=file:./db/custom.db
# (احذف DIRECT_URL عند SQLite — تُهمل تلقائياً)

# ── إدارة Neon (اختياري — للتهيئة والنسخ الاحتياطي برمجياً) ──
# NEON_API_KEY="napi_..."
# NEON_PROJECT_ID="XXXX"

# ── الاختبارات الحية E2E (v4.3) ──
# الافتراضي: فرع Neon مؤقت يُنشأ ويُحذف تلقائياً (يتطلب NEON_API_KEY أعلاه
# ويقرأ DATABASE_URL/DIRECT_URL كأصل للفرع). بديل يدوي بلا مفتاح:
# E2E_DATABASE_URL="postgresql://.../e2e_db?sslmode=require"
# E2E_DIRECT_URL="postgresql://.../e2e_db?sslmode=require"
# DOTENV_KEEP_ENV=1  # يُضبط آلياً من الحاضنة — لا تضبطه يدوياً

# ── v4.5 — فوترة ZATCA (الفاتورة الضريبية المبسطة) ──
# الرقم الضريبي 15 رقماً — مفتاح تفعيل الفوترة كلياً (بدونه: بيع بلا فاتورة رسمية)
# ZATCA_VAT_NUMBER="300012345600003"
# اسم البائع على الفاتورة (افتراضي: صيدلية رُبى)
# ZATCA_SELLER_NAME="صيدلية رُبى"

# ── v4.6 — مراقبة Sentry (اختيارية — بلا مفتاح لا يُهيأ أي شيء) ──
# SENTRY_DSN="https://<key>@o<org>.ingest.sentry.io/<project>"
# SENTRY_TRACES_SAMPLE_RATE="0.1"
# SENTRY_ENVIRONMENT="production"
# مفتاح المتصفح (client key من مشروع Sentry — يظهر في الواجهة بطبيعته)
# NEXT_PUBLIC_SENTRY_DSN=""

# ── v4.6 — اختبارات Playwright E2E (اختياري) ──
# E2E_BASE_URL="http://127.0.0.1:3000"
# E2E_ADMIN_USER="admin"
# E2E_ADMIN_PASSWORD="..."

# ── v4.7 — قفل النظام بمفتاح المدير ──
# البوابة مفعّلة افتراضياً: كل من يفتح النظام يُطلب منه كلمة مرور مدير النظام
# SYSTEM_LOCK="off"          # تعطيل البوابة كلياً (تطوير/اختبارات حصراً)
# LOCK_TTL_HOURS="4"         # مدة سريان الفتح على الجهاز بالساعات (1..168 — الافتراضي 4)
# LOCK_EPOCH="1"             # رافعة السحب الفوري: تغيير القيمة يميت كل مفاتيح الفتح المصدرة سلفاً
