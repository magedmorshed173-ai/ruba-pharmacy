// ربي فارمسي — Ruba Pharmacy Platform v3.0 (Web)
// ملاحظة هندسية: SQLite لا يدعم Decimal في Prisma، لذا تُخزَّن النقود
// كأعداد صحيحة بالهللات (1 ريال = 100 هللة) — المعيار العالمي للدقة المالية.
// الكميات تُخزَّن كأعداد صحيحة (وحدات) — يوحِّد عدم اتساق v2.0 (Decimal مقابل Int).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ───────────────────────── المستخدمون والأدوار ─────────────────────────

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String // bcrypt hash
  fullName  String
  role      String   @default("technician") // admin | pharmacist | technician
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales          Sale[]
  stockMovements StockMovement[]
}

// ───────────────────────────── المخزون ─────────────────────────────

model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  medicines   Medicine[]
}

model Medicine {
  id                   String   @id @default(cuid())
  name                 String
  genericName          String // الاسم العلمي — أساس فحص التداخلات
  categoryId           String
  category             Category @relation(fields: [categoryId], references: [id])
  manufacturer         String?
  barcode              String   @unique
  purchasePrice        Int      @default(0) // هللات
  sellingPrice         Int // هللات
  quantity             Int      @default(0) // وحدات (مجمّع ذاكرة = مجموع الدفعات)
  minQuantity          Int      @default(0) // حد التنبيه
  expiryDate           DateTime // أقرب صلاحية معروفة (تُحدَّث مع الدفعات)
  productionDate       DateTime?
  dosage               String? // الجرعة (مثل 500mg)
  requiresPrescription Boolean  @default(false)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  saleItems SaleItem[]
  movements StockMovement[]
  batches   Batch[]
  poItems   PurchaseOrderItem[]

  @@index([genericName, dosage])
  @@index([expiryDate])
  @@index([name])
}

// دفعات (LOT) — المعيار العالمي في الصيدليات (Odoo/ERPNext):
// صلاحية مستقلة لكل دفعة + صرف FEFO (الأقرب انتهاءً يُصرف أولاً)
model Batch {
  id         String   @id @default(cuid())
  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  lotNumber  String // رقم التشغيلة
  expiryDate DateTime
  quantity   Int      @default(0) // وحدات متبقية بالدفعة
  unitCost   Int      @default(0) // هللات — تكلفة الشراء الفعلية للدفعة
  supplier   String? // المورد
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([medicineId, lotNumber])
  @@index([medicineId, isActive])
  @@index([expiryDate])
}

model DrugInteraction {
  id          String  @id @default(cuid())
  genericA    String
  genericB    String
  severity    String // major | moderate | minor
  description String
  management  String?
  isActive    Boolean @default(true)

  @@unique([genericA, genericB])
  @@index([genericA])
  @@index([genericB])
}

model StockMovement {
  id           String   @id @default(cuid())
  medicineId   String
  medicine     Medicine @relation(fields: [medicineId], references: [id])
  type         String // sale | restock | adjust | return
  delta        Int // موجب = إضافة، سالب = خصم
  balanceAfter Int
  reference    String?
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())

  @@index([medicineId])
  @@index([createdAt])
}

// ───────────────────────── الموردون والمشتريات ─────────────────────────
// المعيار العالمي (Odoo/ERPNext): أمر شراء بحالة، واستلام ذري يولّد دفعات LOT
// بالتكلفة الفعلية — أساس تقارير الأرباح الدقيقة.

model Supplier {
  id        String   @id @default(cuid())
  name      String   @unique
  phone     String?
  email     String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders PurchaseOrder[]

  @@index([name])
}

model PurchaseOrder {
  id           String    @id @default(cuid())
  number       Int       @unique // يُولَّد خادمياً (max+1 داخل معاملة) — SQLite لا يدعم autoincrement خارج المفتاح
  supplierId   String
  supplier     Supplier  @relation(fields: [supplierId], references: [id])
  status       String    @default("draft") // draft | received | cancelled
  totalHalalas Int       @default(0) // مجموع البنود بالهللات — يُحسب خادمياً
  notes        String?
  createdBy    String?
  createdAt    DateTime  @default(now())
  receivedAt   DateTime?

  items PurchaseOrderItem[]

  @@index([status])
  @@index([createdAt])
}

model PurchaseOrderItem {
  id         String        @id @default(cuid())
  poId       String
  po         PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  medicineId String
  medicine   Medicine      @relation(fields: [medicineId], references: [id])
  quantity   Int
  unitCost   Int           // هللات
  lotNumber  String?
  expiryDate DateTime?
  receivedQty Int          @default(0)

  @@index([poId])
}

// ───────────────────────────── المبيعات ─────────────────────────────

model Sale {
  id            String   @id @default(cuid())
  customerName  String   @default("عميل نقدي")
  customerPhone String?
  itemsCount    Int
  totalAmount   Int // هللات
  discount      Int      @default(0) // هللات
  netAmount     Int // هللات
  paymentMethod String   @default("cash") // cash | card | insurance
  status        String   @default("completed") // completed | void
  reference     String   @unique // Idempotency — معرّف العملية الفريد
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  saleDate      DateTime @default(now())

  items SaleItem[]

  @@index([saleDate])
  @@index([userId])
}

model SaleItem {
  id           String   @id @default(cuid())
  saleId       String
  sale         Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  medicineId   String
  medicine     Medicine @relation(fields: [medicineId], references: [id])
  medicineName String
  quantity     Int
  unitPrice    Int // هللات
  subtotal     Int // هللات
  costHalalas  Int @default(0) // لقطة تكلفة الدفعات (FEFO) وقت البيع — أساس تقارير الأرباح

  @@index([saleId])
  @@index([medicineId])
}

// سجل تدقيق الدخول — كل محاولة (نجاح/فشل) مع IP ووكيل المتصفح
model LoginAudit {
  id        String   @id @default(cuid())
  username  String // الاسم المُحاول كما كُتب
  userId    String? // يُملأ عند النجاح فقط
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([username])
}

// ───────────────────────────── المرضى ─────────────────────────────

model Patient {
  id                 String   @id @default(cuid())
  name               String
  nationalId         String   @unique
  phone              String?
  chronicMedications String?
  allergies          String?
  createdAt          DateTime @default(now())

  @@index([name])
  @@index([phone])
}

// ──────────────────────────── الإشعارات ────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  kind      String // expiry | low_stock | info
  title     String
  body      String?
  isRead    Boolean  @default(false)
  dedupeKey String?  @unique // إصلاح: منع التكرار بمفتاح فريد بدل title__contains
  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
}
