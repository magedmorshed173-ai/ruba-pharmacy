// ربي فارمسي — Ruba Pharmacy Platform v3.0 (Web)
// ملاحظة هندسية: SQLite لا يدعم Decimal في Prisma، لذا تُخزَّن النقود
// كأعداد صحيحة بالهللات (1 ريال = 100 هللة) — المعيار العالمي للدقة المالية.
// الكميات تُخزَّن كأعداد صحيحة (وحدات) — يوحِّد عدم اتساق v2.0 (Decimal مقابل Int).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ───────────────────────── المستخدمون والأدوار ─────────────────────────

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String // bcrypt hash
  fullName  String
  role      String   @default("technician") // admin | pharmacist | technician
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales          Sale[]
  stockMovements StockMovement[]
  sessions         Session[]
}

// ───────────────────────────── المخزون ─────────────────────────────

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  medicines   Medicine[]
}

model Medicine {
  id                   String    @id @default(cuid())
  name                 String
  genericName          String // الاسم العلمي — أساس فحص التداخلات
  categoryId           String
  category             Category  @relation(fields: [categoryId], references: [id])
  manufacturer         String?
  barcode              String    @unique
  purchasePrice        Int       @default(0) // هللات
  sellingPrice         Int // هللات
  quantity             Int       @default(0) // وحدات (مجمّع ذاكرة = مجموع الدفعات)
  minQuantity          Int       @default(0) // حد التنبيه
  expiryDate           DateTime // أقرب صلاحية معروفة (تُحدَّث مع الدفعات)
  productionDate       DateTime?
  dosage               String? // الجرعة (مثل 500mg)
  requiresPrescription Boolean   @default(false)
  isActive             Boolean   @default(true)
  atcCode              String? // تصنيف ATC العالمي (مثل B01AC06) — أساس كشف العلاج المكرر
  atcClass             String? // الفئة العلاجية الوظيفية (مثل مضادات التهاب غير ستيرويدية)
  maxDailyDose         Int? // الحد الأقصى للوحدات/يوم — أساس فحص الجرعة
  registrationNo       String? // رقم التسجيل في السجل الوطني للدواء
  registryStatus       String   @default("registered") // registered | suspended | banned | unregistered
  maxRetailPrice       Int? // سقف السعر البيعي الوطني (هللات) — تجاوزه إنذار تسعيري
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  saleItems SaleItem[]
  movements StockMovement[]
  batches   Batch[]
  poItems   PurchaseOrderItem[]
  prescriptionItems PrescriptionItem[]
  regulatoryActions RegulatoryAction[]
  reservations      StockReservation[]

  @@index([genericName, dosage])
  @@index([expiryDate])
  @@index([name])
  @@index([categoryId])
  @@index([atcClass])
}

// دفعات (LOT) — المعيار العالمي في الصيدليات (Odoo/ERPNext):
// صلاحية مستقلة لكل دفعة + صرف FEFO (الأقرب انتهاءً يُصرف أولاً)
model Batch {
  id         String   @id @default(cuid())
  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  lotNumber  String // رقم التشغيلة
  expiryDate DateTime
  quantity   Int      @default(0) // وحدات متبقية بالدفعة
  unitCost   Int      @default(0) // هللات — تكلفة الشراء الفعلية للدفعة
  supplier   String? // المورد
  isActive   Boolean  @default(true)
  isRecalled Boolean   @default(false) // دفعة مسحوبة من التداول — محجوبة عن الصرف نهائياً
  recalledAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([medicineId, lotNumber])
  @@index([medicineId, isActive])
  @@index([expiryDate])
}

// سجل سريري كامل بعد نمط قواعد Lexicomp/Stockley:
// الشدة + الآلية الدوائية + الأثر السريري + خطة الإدارة + مستوى الأدلة + المصدر العلمي
model DrugInteraction {
  id             String  @id @default(cuid())
  genericA       String
  genericB       String
  severity       String // contraindicated | major | moderate | minor
  mechanism      String? // آلية التداخل (مثل: تثبيط CYP2C9، تأثير جمعي على النزف)
  clinicalEffect String? // الأثر السريري المحتمل (مثل: خطر نزف هضمي، ارتفاع INR)
  description    String
  management     String? // خطة الإدارة السريرية الموصى بها
  evidenceLevel  String? // documented | probable | theoretical
  source         String? // المرجع العلمي (مثل: Stockley, Lexicomp, FDA)
  onset          String? // rapid | delayed
  isActive       Boolean @default(true)

  @@unique([genericA, genericB])
  @@index([genericA])
  @@index([genericB])
}

model StockMovement {
  id           String   @id @default(cuid())
  medicineId   String
  medicine     Medicine @relation(fields: [medicineId], references: [id])
  type         String // sale | restock | adjust | return
  delta        Int // موجب = إضافة، سالب = خصم
  balanceAfter Int
  reference    String?
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())

  @@index([medicineId, createdAt])
  @@index([createdAt])
}

// السجل الوطني للدواء — الطبقة التنظيمية فوق الطبقة السريرية
// (نمط SFDA/FDA: تسجيل، تعليق وقائي، حظر، سحب دفعات، سقف تسعيري)
model RegulatoryAction {
  id         String   @id @default(cuid())
  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  actionType String // suspension | ban | recall | reinstatement | price_cap
  scope      String   @default("product") // product | lot
  lotNumber  String? // عند scope = lot
  reason     String // سبب القرار التنظيمي — إلزامي (التوثيق أساس اليقظة الدوائية)
  source     String   @default("SFDA") // الجهة المصدرة للقرار
  value      Int? // هللات — عند actionType = price_cap
  createdBy  String?
  isActive   Boolean  @default(true) // يُطفأ بإجراء لاحق (إعادة تسجيل/رفع القرار)
  createdAt  DateTime @default(now())

  @@index([medicineId, isActive])
  @@index([createdAt])
}

// حجز مخزون وقائي لوصفات قيد الطابور (نمط Allocated/Reserved Stock)
// يمنع نقطة البيع الحرة من بيع وحدات موعودة لوصفة بانتظار التحقق
model StockReservation {
  id                 String    @id @default(cuid())
  prescriptionId     String
  prescriptionItemId String
  medicineId         String
  medicine           Medicine  @relation(fields: [medicineId], references: [id])
  quantity           Int
  status             String    @default("active") // active | released | consumed
  createdAt          DateTime  @default(now())
  closedAt           DateTime? // لحظة الإفراج أو الاستهلاك

  @@index([medicineId, status])
  @@index([prescriptionId])
}

// تتبع دفعات الصرف — أي دفعة (LOT) صُرف منها في أي فاتورة
// أساس التتبع الأمامي عند سحب دفعة: من أخذ ماذا ومتى (نمط GS1 Track & Trace)
model SaleItemBatch {
  id         String   @id @default(cuid())
  saleItemId String
  saleItem   SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  batchId    String
  lotNumber  String
  quantity   Int

  @@index([batchId])
  @@index([saleItemId])
}

// ───────────────────────── الموردون والمشتريات ─────────────────────────
// المعيار العالمي (Odoo/ERPNext): أمر شراء بحالة، واستلام ذري يولّد دفعات LOT
// بالتكلفة الفعلية — أساس تقارير الأرباح الدقيقة.

model Supplier {
  id        String   @id @default(cuid())
  name      String   @unique
  phone     String?
  email     String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders PurchaseOrder[]

  @@index([name])
}

model PurchaseOrder {
  id           String    @id @default(cuid())
  number       Int       @unique // يُولَّد خادمياً (max+1 داخل معاملة) — SQLite لا يدعم autoincrement خارج المفتاح
  supplierId   String
  supplier     Supplier  @relation(fields: [supplierId], references: [id])
  status       String    @default("draft") // draft | received | cancelled
  totalHalalas Int       @default(0) // مجموع البنود بالهللات — يُحسب خادمياً
  notes        String?
  createdBy    String?
  createdAt    DateTime  @default(now())
  receivedAt   DateTime?

  items PurchaseOrderItem[]

  @@index([status])
  @@index([createdAt])
}

model PurchaseOrderItem {
  id          String        @id @default(cuid())
  poId        String
  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  medicineId  String
  medicine    Medicine      @relation(fields: [medicineId], references: [id])
  quantity    Int
  unitCost    Int // هللات
  lotNumber   String?
  expiryDate  DateTime?
  receivedQty Int           @default(0)

  @@index([poId])
  @@index([medicineId])
}

// ───────────────────────────── المبيعات ─────────────────────────────

model Sale {
  id               String   @id @default(cuid())
  customerName     String   @default("عميل نقدي")
  customerPhone    String?
  itemsCount       Int
  totalAmount      Int // هللات
  discount         Int      @default(0) // هللات
  netAmount        Int // هللات
  paymentMethod    String   @default("cash") // cash | card | insurance
  status           String   @default("completed") // completed | void
  reference        String   @unique // Idempotency — معرّف العملية الفريد
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  patientId        String? // المريض المرتبط — أساس فحص الحساسية والأمراض المزمنة
  patientName      String? // لقطة اسم المريض وقت البيع
  clinicalOverride Boolean  @default(false) // هل تم تجاوز سريري مسؤول؟ (يُراجع في التدقيق)
  saleDate         DateTime @default(now())

  items SaleItem[]

  @@index([saleDate])
  @@index([userId])
  @@index([status])
}

model SaleItem {
  id           String   @id @default(cuid())
  saleId       String
  sale         Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  medicineId   String
  medicine     Medicine @relation(fields: [medicineId], references: [id])
  medicineName String
  quantity     Int
  unitPrice    Int // هللات
  subtotal     Int // هللات
  costHalalas  Int      @default(0) // لقطة تكلفة الدفعات (FEFO) وقت البيع — أساس تقارير الأرباح

  @@index([saleId])
  @@index([medicineId])

  batches SaleItemBatch[]
}

// سجل تدقيق الدخول — كل محاولة (نجاح/فشل) مع IP ووكيل المتصفح
model LoginAudit {
  id        String   @id @default(cuid())
  username  String // الاسم المُحاول كما كُتب
  userId    String? // يُملأ عند النجاح فقط
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([username])
}

// ──────────────────────── طابور التحقق الصيدلي ────────────────────────
// المعيار الغربي (Fill → Verify → Dispense — PioneerRx/Epic Willow):
// الوصفة تدخل طابوراً مستقلاً، صيدلي يتحقق منها بمطابقة باركود لكل بند،
// ثم تُصرف ذرياً عبر محرك البيع نفسه (FEFO + بوابة سريرية + دفتر).

model Prescription {
  id               String    @id @default(cuid())
  number           Int       @unique // يُولَّد خادمياً (max+1 داخل معاملة)
  status           String    @default("pending") // pending | verified | rejected | dispensed
  patientId        String?   // المريض — أساس المراجعة السريرية
  patientName      String?   // لقطة اسم المريض
  doctorName       String?   // الطبيب الواصف
  notes            String?
  rejectReason     String?   // إلزامي عند الرفض
  clinicalOverride Boolean   @default(false) // تجاوز مسؤول مسجّل عند التحقق
  createdBy        String    // من أدخل الوصفة (فني/صيدلي/مدير)
  creatorName      String?   // لقطة اسم الداخل
  verifiedBy       String?   // الصيدلي المتحقق
  verifierName     String?
  verifiedAt       DateTime?
  saleId           String?   // الفاتورة الناتجة عن الصرف
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  items PrescriptionItem[]

  @@index([status, createdAt])
  @@index([patientId])
}

model PrescriptionItem {
  id             String       @id @default(cuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicineId     String
  medicine       Medicine     @relation(fields: [medicineId], references: [id])
  medicineName   String       // لقطة وقت الإدخال
  quantity       Int
  instructions   String?      // إرشادات الاستخدام
  verified       Boolean      @default(false) // مطابقة باركود فردية لكل بند

  @@index([prescriptionId])
  @@index([medicineId])
}

// ───────────────────────────── المرضى ─────────────────────────────

model Patient {
  id                 String   @id @default(cuid())
  name               String
  nationalId         String   @unique
  phone              String?
  chronicMedications String?
  allergies          String?
  createdAt          DateTime @default(now())

  @@index([name])
  @@index([phone])
}

// ──────────────────────────── الإشعارات ────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  kind      String // expiry | low_stock | info
  title     String
  body      String?
  isRead    Boolean  @default(false)
  dedupeKey String?  @unique // إصلاح: منع التكرار بمفتاح فريد بدل title__contains
  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
}

/// جلسة دخول قابلة للسحب (v3.9) — كل توكن JWT يقابله صف هنا؛
/// بلا صف أو صف مسحوب = التوكن ميت فوراً حتى لو لم تنته صلاحيته
model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique // SHA-256 للتوكن — لا يُخزن التوكن الخام أبداً
  deviceHash String? // SHA-256 لـ User-Agent — ربط الجهاز: التوكن المسروق من متصفح آخر يُرفض
  ip         String?
  userAgent  String?
  revokedAt  DateTime?
  lastUsedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@index([userId, revokedAt])
}
/// دليل الدواء الوطني (v4.0) — المحتوى المرخص المرجعي الذي يراه العميل،
/// منفصل عن المخزون التشغيلي (Medicine) ومرتبط باختياري عبر باركود المنتج
/// المخزّن لتفعيل «التوفر الحي» و«السعر الفعلي» في نشرة الدواء.
model Drug {
  id                String   @id @default(cuid())
  tradeName         String   @unique
  scientificName    String // المادة الفعالة (لاتيني) — مفتاح التفاعلات والبدائل
  scientificNameAr  String? // المادة الفعالة بالعربية — لبحث العميل بالعربية
  atcCode           String?
  atcClass          String?
  form              String // الشكل الجرعي (أقراص، شراب، بخاخ…)
  strength          String // التركيز (500 ملغ…)
  manufacturer      String
  country           String?
  priceHalalas      Int // السعر الرسمي المرخص (هللات — معيار النقود بالمشروع)
  requiresRx        Boolean  @default(true) // بيع بموجب وصفة طبية
  category          String // الفئة العلاجية العربية
  indications       String // دواعي الاستعمال
  dosageGuide       String // طريقة الاستعمال والجرعة
  sideEffects       String // الآثار الجانبية المحتملة
  contraindications String // موانع الاستعمال
  pregnancyCategory String? // فئة الحمل (FDA): A B C D X
  storage           String?
  registrNo         String?  @unique // رقم التسجيل بالسجل الوطني للدواء
  linkedBarcode     String? // باركود المنتج المخزّن (Medicine.barcode) — التوفر الحي
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([scientificName])
  @@index([category])
  @@index([isActive, tradeName])
}
